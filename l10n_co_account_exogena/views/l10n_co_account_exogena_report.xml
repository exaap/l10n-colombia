<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_co_account_exogena_report_tree" model="ir.ui.view">
        <field name="model">l10n_co.account.exogena.report</field>
        <field name="arch" type="xml">
            <tree string="Exogena Report">
                <field name="name"/>
                <field name="year"/>
            </tree>
        </field>
    </record>

    <record id="l10n_co_account_exogena_report_form" model="ir.ui.view">
        <field name="model">l10n_co.account.exogena.report</field>
        <field name="arch" type="xml">
            <form string="Exogena Report">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="year"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Exogena Report Lines">
                            <group>
                                <field name="exogena_report_line_ids" mode="tree">
                                    <tree>
                                        <field name="concept"/>
                                        <field name="account_id"/>
                                        <field name="column"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_co_account_exogena_report_action" model="ir.actions.act_window">
        <field name="name">Exogena Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_co.account.exogena.report</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="l10n_co_account_exogena_report_menu" name="Exogena Reports"
        action="l10n_co_account_exogena_report_action" parent="account.account_account_menu" sequence="99"/>
</odoo>
